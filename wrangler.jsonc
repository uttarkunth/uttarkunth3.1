{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uttarkunth3-1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "node scripts/cloudflare-build.mjs"
  }
}
